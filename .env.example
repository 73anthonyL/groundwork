# Postgres connection. Leave empty to run on embedded PGlite at ./.data/pglite (dev/tests).
DATABASE_URL=

# Claude API key: needed for contract compile, pay-app flags, "explain this payment", and contract generation.
ANTHROPIC_API_KEY=

# Signs the persona-session cookie (any long random string).
SESSION_SECRET=change-me-to-a-long-random-string

# Payment rail: simulated | ramp
PAYMENT_RAIL=simulated
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
RAMP_API_BASE=https://demo-api.ramp.com
# Ramp bills need an existing vendor and entity. Map each sub org id to its Ramp vendor id.
RAMP_ENTITY_ID=
RAMP_VENDOR_MAP={}
RAMP_PAYMENT_METHOD=ACH
# Printed by `pnpm ramp:webhook https://<app-host>`. Webhooks are rejected while this is empty.
RAMP_WEBHOOK_SECRET=

# Demo controls. In production the HTTP reset endpoint is off unless DEMO_RESET_TOKEN is set.
DEMO_RESET_TOKEN=
DEMO_NOW=
DEMO_PRECOMPILED=
