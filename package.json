{
  "name": "groundwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx src/db/seed.ts",
    "demo:reset": "node --env-file-if-exists=.env.local --import tsx scripts/demo-reset.ts",
    "render:contracts": "node --env-file-if-exists=.env.local --import tsx scripts/render-contracts.tsx",
    "gen:contracts": "node --env-file-if-exists=.env.local --import tsx scripts/gen-contracts.tsx",
    "ramp:webhook": "node --env-file-if-exists=.env.local --import tsx scripts/ramp-webhook.ts",
    "eval:fetch": "node --import tsx evals/fetch-real.ts",
    "eval:specs": "node --import tsx evals/build-specs.ts",
    "eval": "node --env-file-if-exists=.env.local --import tsx evals/run.ts",
    "eval:check": "node --import tsx evals/run.ts --cache-only --check",
    "eval:gate": "node --import tsx scripts/eval-gate.ts",
    "eval:report": "node --import tsx scripts/eval-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.13",
    "@neondatabase/serverless": "^1.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.14",
    "lucide-react": "^1.65.0",
    "motion": "^14.8.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
